generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  PRODUTOR
  ADMIN
  SUPER_ADMIN
}

enum AnimalEspecie {
  BOVINO
  SUINO
  AVICOLA
  OVINO
  CAPRINO
  EQUINO
  OUTRO
}

enum AnimalSexo {
  MACHO
  FEMEA
}

enum AnimalStatus {
  ATIVO
  VENDIDO
  MORTO
  TRANSFERIDO
}

enum AnimalEventoTipo {
  PESAGEM
  VACINACAO
  VENDA
  DOENCA
  REPRODUCAO
  OBSERVACAO
}

enum CulturaStatus {
  PLANEJADA
  PLANTADA
  EM_CRESCIMENTO
  COLHIDA
  PERDIDA
}

enum TransacaoCategoria {
  ALIMENTACAO
  SAUDE_ANIMAL
  INSUMOS
  EQUIPAMENTOS
  COMBUSTIVEL
  MAO_DE_OBRA
  VENDA_ANIMAL
  VENDA_PRODUCAO
  FINANCIAMENTO
  OUTROS
}

enum NotificacaoTipo {
  INFO
  ALERTA
  URGENTE
  SISTEMA
}

enum ReproducaoStatus {
  PRENHA
  PARTO_REALIZADO
  VAZIA
}

enum MarketplaceStatus {
  ATIVO
  INATIVO
  VENDIDO
  REMOVIDO
}

enum MarketplaceCategoria {
  INSUMOS
  MAQUINARIOS
  PECUARIA
  GRAOS
  FERTILIZANTES
  FERRAMENTAS
  SERVICOS
  SEMENTES
  RACAO
  IRRIGACAO
  HORTIFRUTI
  EQUIPAMENTOS
}

enum PlanStatus {
  ATIVO
  INATIVO
  ARQUIVADO
}

enum SubscriptionStatus {
  ATIVA
  CANCELADA
  EXPIRADA
  TRIAL
}

// ─── Modelos ──────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role                 UserRole  @default(PRODUTOR)
  avatarUrl            String?   @map("avatar_url")
  isActive             Boolean   @default(true) @map("is_active")
  onboardingCompleted  Boolean   @default(false) @map("onboarding_completed")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  produtor      Produtor?
  notificacoes  Notificacao[]
  subscription  Subscription?
  favoritos     MarketplaceFavorito[]

  @@map("users")
}

model Produtor {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  cpf               String?  @unique
  telefone          String?
  estado            String?  @db.Char(2)
  cidade            String?
  bio               String?  @db.Text
  tipoProducao      String?  @map("tipo_producao")
  producoesVegetais String[] @map("producoes_vegetais")
  producoesAnimais  String[] @map("producoes_animais")
  objetivoPrincipal String?  @map("objetivo_principal")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  propriedades       Propriedade[]
  marketplaceProducts MarketplaceProduct[]

  @@map("produtores")
}

model Propriedade {
  id           String   @id @default(uuid())
  produtorId   String   @map("produtor_id")
  nome         String
  areaHectares Float    @map("area_hectares")
  municipio    String
  estado       String   @db.Char(2)
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  produtor   Produtor   @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  animais    Animal[]
  culturas   Cultura[]
  despesas   Despesa[]
  receitas   Receita[]
  relatorios Relatorio[]

  @@map("propriedades")
}

model Animal {
  id                 String        @id @default(uuid())
  propriedadeId      String        @map("propriedade_id")
  nome               String?
  numeroIdentificacao String?      @map("numero_identificacao")
  especie            AnimalEspecie
  raca               String?
  sexo               AnimalSexo
  dataNascimento     DateTime?     @map("data_nascimento")
  pesoKg             Float?        @map("peso_kg")
  status             AnimalStatus  @default(ATIVO)
  observacoes        String?       @db.Text
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  propriedade Propriedade  @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  eventos             AnimalEvento[]
  vacinas             Vacina[]
  pesagens            Pesagem[]
  reproducoes         Reproducao[]  @relation("matriz")
  reproducoesParceiro Reproducao[]  @relation("parceiro")
  despesas            Despesa[]
  receitas            Receita[]

  @@map("animais")
}

model AnimalEvento {
  id        String           @id @default(uuid())
  animalId  String           @map("animal_id")
  tipo      AnimalEventoTipo
  descricao String           @db.Text
  data      DateTime
  valor     Float?
  createdAt DateTime         @default(now()) @map("created_at")

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@map("animal_eventos")
}

model Vacina {
  id            String    @id @default(uuid())
  animalId      String    @map("animal_id")
  nomeVacina    String    @map("nome_vacina")
  dataAplicacao DateTime  @map("data_aplicacao")
  proximaDose   DateTime? @map("proxima_dose")
  observacoes   String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@map("vacinas")
}

model Pesagem {
  id          String   @id @default(uuid())
  animalId    String   @map("animal_id")
  pesoKg      Float    @map("peso_kg")
  dataPesagem DateTime @map("data_pesagem")
  observacoes String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@map("pesagens")
}

model Reproducao {
  id                String           @id @default(uuid())
  animalId          String           @map("animal_id")
  parceiroId        String?          @map("parceiro_id")
  dataCobertura     DateTime         @map("data_cobertura")
  dataPrevistaParto DateTime?        @map("data_prevista_parto")
  dataPartoReal     DateTime?        @map("data_parto_real")
  quantidadeFilhos  Int?             @map("quantidade_filhos")
  observacoes       String?          @db.Text
  status            ReproducaoStatus @default(PRENHA)
  createdAt         DateTime         @default(now()) @map("created_at")

  animal   Animal  @relation("matriz",   fields: [animalId],   references: [id], onDelete: Cascade)
  parceiro Animal? @relation("parceiro", fields: [parceiroId], references: [id], onDelete: SetNull)

  @@map("reproducao")
}

model Cultura {
  id                    String        @id @default(uuid())
  propriedadeId         String        @map("propriedade_id")
  nome                  String
  tipo                  String
  areaHectares          Float         @map("area_hectares")
  dataPlantio           DateTime?     @map("data_plantio")
  dataColheitaEstimada  DateTime?     @map("data_colheita_estimada")
  status                CulturaStatus @default(PLANEJADA)
  producaoKg            Float?        @map("producao_kg")
  observacoes           String?       @db.Text
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)

  @@map("culturas")
}

model PrecoAgricola {
  id        String   @id @default(uuid())
  produto   String
  preco     Float
  unidade   String
  estado    String?  @db.Char(2)
  fonte     String?
  data      DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("precos_agricolas")
}

model Despesa {
  id            String              @id @default(uuid())
  propriedadeId String              @map("propriedade_id")
  animalId      String?             @map("animal_id")
  descricao     String
  valor         Float
  data          DateTime
  categoria     TransacaoCategoria  @default(OUTROS)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  animal      Animal?     @relation(fields: [animalId], references: [id], onDelete: SetNull)

  @@map("despesas")
}

model Receita {
  id            String              @id @default(uuid())
  propriedadeId String              @map("propriedade_id")
  animalId      String?             @map("animal_id")
  descricao     String
  valor         Float
  data          DateTime
  categoria     TransacaoCategoria  @default(VENDA_PRODUCAO)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  animal      Animal?     @relation(fields: [animalId], references: [id], onDelete: SetNull)

  @@map("receitas")
}

model Relatorio {
  id            String   @id @default(uuid())
  propriedadeId String   @map("propriedade_id")
  titulo        String
  tipo          String
  url           String?
  dados         Json?
  criadoEm     DateTime @default(now()) @map("criado_em")

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)

  @@map("relatorios")
}

model Notificacao {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  titulo    String
  mensagem  String          @db.Text
  tipo      NotificacaoTipo @default(INFO)
  lida      Boolean         @default(false)
  criadoEm DateTime        @default(now()) @map("criado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notificacoes")
}

model MarketplaceProduct {
  id               String               @id @default(uuid())
  produtorId       String               @map("produtor_id")
  titulo           String
  descricao        String               @db.Text
  categoria        MarketplaceCategoria @default(INSUMOS)
  preco            Float
  precoNegociavel  Boolean              @default(false) @map("preco_negociavel")
  quantidade       Float
  unidade          String               @default("un")
  cidade           String?
  estado           String?              @db.Char(2)
  imageUrl         String?              @map("image_url")
  imagensExtra     String[]             @map("imagens_extra")
  externalUrl      String?              @map("external_url")
  contatoWhatsapp  String?              @map("contato_whatsapp")
  contatoEmail     String?              @map("contato_email")
  contatoTelefone  String?              @map("contato_telefone")
  destaque         Boolean              @default(false)
  visualizacoes    Int                  @default(0)
  status           MarketplaceStatus    @default(ATIVO)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  produtor  Produtor              @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  favoritos MarketplaceFavorito[]
  contatos  MarketplaceContato[]

  @@map("marketplace_products")
}

model MarketplaceFavorito {
  id        String   @id @default(uuid())
  produtoId String   @map("produto_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  produto MarketplaceProduct @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([produtoId, userId])
  @@map("marketplace_favoritos")
}

model MarketplaceContato {
  id        String   @id @default(uuid())
  produtoId String   @map("produto_id")
  userId    String?  @map("user_id")
  tipo      String
  createdAt DateTime @default(now()) @map("created_at")

  produto MarketplaceProduct @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("marketplace_contatos")
}

model Plan {
  id                  String      @id @default(uuid())
  nome                String
  preco               Float
  descricao           String      @db.Text
  features            String[]
  limitePropriedades  Int         @default(1) @map("limite_propriedades")
  limiteAnimais       Int         @default(50) @map("limite_animais")
  status              PlanStatus  @default(ATIVO)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id          String             @id @default(uuid())
  userId      String             @unique @map("user_id")
  planId      String             @map("plan_id")
  status      SubscriptionStatus @default(TRIAL)
  dataInicio  DateTime           @default(now()) @map("data_inicio")
  dataFim     DateTime           @map("data_fim")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}
